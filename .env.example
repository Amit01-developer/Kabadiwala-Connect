APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///../.data/kabadwala.sqlite3
UPLOAD_DIR=../.data/uploads
ACCESS_TOKEN_HOURS=12
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional cloud services. Leave S3_BUCKET and REDIS_URL blank for local-only mode.
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REDIS_URL=
POSTGIS_ENABLED=false

# Optional trained model files; paths are relative to the backend working directory.
CLASSIFIER_MODEL_PATH=
PRICE_MODEL_PATH=

# Leave blank to use Vite's local API proxy in development.
VITE_API_URL=
VITE_DEMO_ACCESS=true

# Used by docker compose only.
POSTGRES_DB=kabadiwala
POSTGRES_USER=kabadiwala
POSTGRES_PASSWORD=
